# ROCK BASE runtime configuration
# Copy to backend/.env for a manual install, or run setup-rockbase.ps1 on Windows.
# Never commit backend/.env.

PORT=3010
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3010"
AUTOMATION_ENABLED=false
DATABASE_URL="file:./dev.db"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
MAX_BULK_SESSION_CHECK=3
SESSION_HEALTH_CHECK_CONCURRENCY=2

# REQUIRED: use a unique secret of at least 32 characters.
JWT_SECRET="REPLACE_WITH_A_UNIQUE_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="24h"

# REQUIRED AND DATA-RECOVERY-CRITICAL: exactly 64 hex characters.
# Existing installations: DO NOT rotate or replace this key. Saved sessions
# can only be recovered with the original database AND this exact key.
ENCRYPTION_KEY="REPLACE_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS"

# Fresh-install only. setup-rockbase.ps1 generates these automatically.
# Bootstrap only succeeds when no User exists; disable/remove after first login.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_TOKEN=""

# Optional AI features
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
VISION_PROVIDER="auto"
GEMINI_VISION_MODEL="gemini-flash-latest"
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
